# Copy to .env (loaded by Node through Next's env loader).
PORT=3000
# Speaker-reachable private IPv4 HTTP origin. Live radio auto-selects an unambiguous LAN interface; set explicitly if needed.
# PUBLIC_BASE_URL=http://192.168.1.50:3000
# Optional: bind discovery to this Mac's network interface.
# SONOS_INTERFACE=192.168.1.50
# SONOS_MOCK=1
# PAIRING_CODE=choose-a-long-random-password
# Obtain an approved SoundCloud developer application. Never prefix secrets NEXT_PUBLIC_.
# SOUNDCLOUD_CLIENT_ID=
# SOUNDCLOUD_CLIENT_SECRET=
# Must exactly match your registered SoundCloud redirect URI.
# SOUNDCLOUD_REDIRECT_URI=http://localhost:3000/api/soundcloud/callback
